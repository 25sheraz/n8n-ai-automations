    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const name = ($json[\"Name\"] || \"\").trim();\nconst company = ($json[\"Company\"] || \"\").trim();\n\nconst pick = arr => arr[Math.floor(Math.random() * arr.length)];\n\nlet opening_message;\n\nif (name && company) {\n  opening_message = pick([\n    `Hi ${name}, this is a voice AI built by DevelMo — I'm calling about something that could save ${company} a good chunk of time. Got 30 seconds?`,\n    `Hey ${name}, I'm an AI voice agent from DevelMo. Quick reason for the call — got something ${company} might want to hear before your competitors do. You got a sec?`\n  ]);\n} else if (name) {\n  opening_message = pick([\n    `Hi ${name}, this is a voice AI built by DevelMo — I promise this isn't the usual cold call. Got a moment?`,\n    `Hey ${name}, I'm an AI voice agent from DevelMo, and I've got something worth 30 seconds of your time. Interested?`\n  ]);\n} else if (company) {\n  opening_message = pick([\n    `Hi, I'm a voice AI built by DevelMo — I've got something that might genuinely interest ${company}. Who am I speaking with?`,\n    `Hey, this is an AI voice agent from DevelMo — calling with something ${company} probably hasn't heard yet. Who's this?`\n  ]);\n} else {\n  opening_message = pick([\n    `Hi there, I'm a voice AI built by DevelMo, and I promise this call is more interesting than it sounds. Who am I speaking with?`,\n    `Hey, this is an AI voice agent from DevelMo — calling about something worth 30 seconds. Who's this?`\n  ]);\n}\n\nreturn {\n  ...$json,\n  opening_message\n};"
      },
